{
  "name": "may-be-gay",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.19.0 <23",
    "npm": ">=10.9.3 <11"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:http": "node --import tsx scripts/http-smoke.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:e2e:runner": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1165.0",
    "better-auth": "1.7.19",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "postgres": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
