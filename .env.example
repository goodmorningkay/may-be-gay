# LOCAL DEVELOPMENT ONLY. These deliberately public values must never be used
# for production. Compose already has matching local defaults.
# The application's code default is may-be.gay; local Compose uses this domain.
SITE_DOMAIN=may-be.localhost

# Container URLs. For host-side npm tooling with compose.tools.yaml, replace
# db with 127.0.0.1 in your shell's environment (see docs/development.md).
DATABASE_URL=postgres://may_be_app:local-only-app@db:5432/may_be_gay
MIGRATION_DATABASE_URL=postgres://may_be_migrator:local-only-migrator@db:5432/may_be_gay

# Required in production. Share this exact path and underlying volume with
# app, worker and the offline restore command. Any marker or restored DB status blocks
# requests and worker startup until an operator explicitly reopens the service.
SERVICE_CLOSED_FILE=/app/var/service/SERVICE_CLOSED
# Persist private recovery scratch and retention checkpoints across worker restarts.
BACKUP_WORK_ROOT=/app/var/recovery
# Stable flock shared by every app/worker/recovery parser on this host and uid.
NATIVE_PARSER_LOCK_FILE=/app/var/native/parser.lock

# Cluster bootstrap only. Only the migration service receives the migration URL.
# Updating passwords on an
# existing volume also requires explicitly rerunning bootstrap (see docs).
POSTGRES_PASSWORD=local-only-bootstrap
MIGRATION_DATABASE_PASSWORD=local-only-migrator
APP_DATABASE_PASSWORD=local-only-app

# Deliberately public local-only secret; replace for any real installation.
BETTER_AUTH_SECRET=local-only-auth-secret-change-before-any-real-use
# Private local mail/media. Host-side tooling must use private host paths instead.
MAIL_TRANSPORT=local
MAIL_OUTBOX_DIR=/app/var/mail
MEDIA_STORAGE=local
MEDIA_LOCAL_ROOT=/app/var/media
# Live mail, provider credentials and policy approval are intentionally absent.
